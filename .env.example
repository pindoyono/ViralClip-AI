# =============================================================================
# ViralClip AI - Environment Variables Example
# Copy this file to .env and fill in your values
# =============================================================================

# Application
NODE_ENV=development
APP_NAME=ViralClip AI
APP_VERSION=0.1.0
APP_URL=http://localhost:3000

# API Server
API_PORT=8080
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:8080
API_READ_TIMEOUT=30s
API_WRITE_TIMEOUT=30s
API_IDLE_TIMEOUT=120s
API_MAX_BODY_SIZE=500MB

# Worker
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=5s
WORKER_MAX_RETRIES=3

# AI Service
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=300s

# Frontend (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# Database
# =============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=viralclip
DATABASE_USER=viralclip
DATABASE_PASSWORD=viralclip_dev_password
DATABASE_SSL_MODE=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=5m
DATABASE_URL=postgresql://viralclip:viralclip_dev_password@localhost:5432/viralclip?sslmode=disable

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=168h
JWT_ISSUER=viralclip-ai

# =============================================================================
# Google OAuth2 & APIs
# =============================================================================
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file
YOUTUBE_DATA_API_KEY=your-youtube-data-api-key
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload

# =============================================================================
# TikTok API
# =============================================================================
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# =============================================================================
# Instagram Graph API
# =============================================================================
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback

# =============================================================================
# Storage - Google Cloud Storage
# =============================================================================
STORAGE_PROVIDER=local
GCS_BUCKET_NAME=viralclip-videos
GCS_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Local storage fallback
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_URL=http://localhost:8080/storage

# =============================================================================
# OpenAI
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# =============================================================================
# Whisper (Speech-to-Text)
# =============================================================================
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# =============================================================================
# FFmpeg
# =============================================================================
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_MAX_THREADS=4

# =============================================================================
# Queue (Redis-based)
# =============================================================================
QUEUE_DRIVER=redis
QUEUE_VIDEO_PROCESSING=video:processing
QUEUE_PUBLISHING=social:publishing
QUEUE_ANALYTICS=analytics:update
QUEUE_CLEANUP=cleanup:tasks
QUEUE_MAX_JOBS=100

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_BURST=20

# =============================================================================
# Email (SMTP)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@viralclip.ai
SMTP_FROM_NAME=ViralClip AI

# =============================================================================
# Stripe (Billing)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRICE_STARTER=price_starter_monthly
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_OUTPUT=stdout

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_MAX_AGE=86400

# =============================================================================
# Monitoring
# =============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
